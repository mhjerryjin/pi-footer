{
  "name": "@mhjerryjin/pi-footer",
  "version": "0.1.8",
  "description": "A compact Pi footer showing model, Git, context, quotas, and active work/subagent status.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "footer",
    "context",
    "usage",
    "quota"
  ],
  "author": "Jerry (https://github.com/mhjerryjin)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhjerryjin/pi-footer.git"
  },
  "homepage": "https://github.com/mhjerryjin/pi-footer#readme",
  "bugs": {
    "url": "https://github.com/mhjerryjin/pi-footer/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0 <1",
    "@earendil-works/pi-tui": ">=0.80.0 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/mhjerryjin/pi-footer/main/assets/pi-footer-preview.png"
  },
  "files": [
    "index.ts",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
